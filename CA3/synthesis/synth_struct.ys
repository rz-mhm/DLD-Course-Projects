# Read SystemVerilog files
read_verilog -sv ../structural/adder16.sv
read_verilog -sv ../structural/bitwise_unit.sv
read_verilog -sv ../structural/mux_2to1_16b.sv
read_verilog -sv ../structural/mux_4to1_16b.sv
read_verilog -sv ../structural/alu_struct.sv

# Generic synthesis
synth -top alu_struct

# Map to custom cell library
dfflibmap -liberty mycells.lib
abc -liberty mycells.lib
clean

# Print statistics
stat

# Write the synthesized netlist
write_verilog -noattr alu_struct_netlist.v
